      <aliases enabled='yes' />
      <column caption='Average Order Value' datatype='real' name='[Calculation_1371143168712704]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sales]) / COUNTD([order_id])' />
      </column>
      <column caption='Repeat Customer Rate' datatype='real' name='[Calculation_1371143169449985]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF { FIXED [customer_unique_id] : COUNTD([order_id]) } &gt; 1&#13;&#10;    THEN [customer_unique_id]&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD([customer_unique_id])' />
      </column>
      <column caption='CATEGORY DISPLAY' datatype='string' name='[Calculation_1371143183638530]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [category] = &quot;health_beauty&quot; THEN &quot;Health &amp; Beauty&quot;&#13;&#10;ELSEIF [category] = &quot;watches_gifts&quot; THEN &quot;Watches &amp; Gifts&quot;&#13;&#10;ELSEIF [category] = &quot;bed_bath_table&quot; THEN &quot;Bed &amp; Bath&quot;&#13;&#10;ELSEIF [category] = &quot;sports_leisure&quot; THEN &quot;Sports &amp; Leisure&quot;&#13;&#10;ELSEIF [category] = &quot;computers_accessories&quot; THEN &quot;Computers &amp; Accessories&quot;&#13;&#10;ELSE [category]&#13;&#10;END' />
      </column>
